{
  "name": "gitomic",
  "version": "0.4.0",
  "description": "Atomic, merge-free state commits over git: compare-and-swap on a ref with semantic replay.",
  "keywords": [
    "atomic",
    "cas",
    "compare-and-swap",
    "database",
    "event-sourcing",
    "git",
    "optimistic-concurrency",
    "state",
    "transaction"
  ],
  "homepage": "https://github.com/beorn/gitomic#readme",
  "bugs": "https://github.com/beorn/gitomic/issues",
  "license": "MIT",
  "author": "Bjørn Stabell <bjorn@stabell.org>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/beorn/gitomic.git"
  },
  "bin": {
    "gitomic": "./src/bin.ts"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts",
    "./adapters": "./src/adapters.ts",
    "./checkout-lock": "./src/checkout-lock.ts",
    "./events": "./src/events.ts",
    "./iso": "./src/iso.ts",
    "./mem": "./src/mem.ts"
  },
  "publishConfig": {
    "bin": {
      "gitomic": "./dist/bin.js"
    },
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      },
      "./adapters": {
        "types": "./dist/adapters.d.ts",
        "import": "./dist/adapters.js"
      },
      "./checkout-lock": {
        "types": "./dist/checkout-lock.d.ts",
        "import": "./dist/checkout-lock.js"
      },
      "./events": {
        "types": "./dist/events.d.ts",
        "import": "./dist/events.js"
      },
      "./iso": {
        "types": "./dist/iso.d.ts",
        "import": "./dist/iso.js"
      },
      "./mem": {
        "types": "./dist/mem.d.ts",
        "import": "./dist/mem.js"
      }
    },
    "access": "public"
  },
  "scripts": {
    "bench": "bun benchmarks/backends.ts",
    "build": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.build.json && node scripts/fix-dist-shebang.mjs",
    "check": "bun run format && bun run lint && bun run typecheck && bun run test && bun run build && bun run smoke:node",
    "format": "oxfmt --check .",
    "format:write": "oxfmt .",
    "lint": "oxlint src tests benchmarks",
    "prepack": "bun run build",
    "smoke:node": "node scripts/node-smoke.mjs",
    "test": "vitest run",
    "test:stress": "vitest run --config vitest.stress.config.ts",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@bearly/flock": "^0.1.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "isomorphic-git": "^1.38.7",
    "oxfmt": "^0.59.0",
    "oxlint": "^1.74.0",
    "typescript": "^7.0.2",
    "unstorage": "^1.17.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "isomorphic-git": "^1.38.7"
  },
  "peerDependenciesMeta": {
    "isomorphic-git": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=20"
  }
}
